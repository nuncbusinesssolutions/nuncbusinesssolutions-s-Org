# GEMINI_API_KEY: Optional for AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE (Required for Production Backend & Realtime)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in VITE_* frontend variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

